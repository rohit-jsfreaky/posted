# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling
.playwright-mcp/

# preview renders, regenerated by tools/preview.py
tools/out/

# Working notes. They live on, locally and in history, but the repo's front page
# is for somebody who wants to play the game or read the source — not for the
# plan, the level spec, the art brief or the running log.
/ART.md
/DESIGN.md
/LEVELS.md
/MASTER-PLAN.md
/PROGRESS.md
/SHIP.md
# and a note about another entrant, which really does not belong in a public repo
/FIELD.md

# Screenshots taken while building. docs/shots/ is the set the README uses and
# stays; these are the other sixteen megabytes.
docs/phase*/
docs/ui/

# Playwright MCP wiring, which carries absolute paths off one machine
/.mcp.json
